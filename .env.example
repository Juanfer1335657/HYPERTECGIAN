# Neon Database (get from your Neon project dashboard)
# Formato: postgresql://username:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob (automatically provided in Vercel when you add blob storage)
# Get this from your Vercel dashboard: Storage > Blobs > Settings
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token"

# Admin credentials
ADMIN_EMAIL="admin@hypertecgian.com"
ADMIN_PASSWORD="your_secure_password"

# JWT Secret (generate a secure random string, at least 32 characters)
JWT_SECRET="your_super_secret_jwt_key_min_32_chars"